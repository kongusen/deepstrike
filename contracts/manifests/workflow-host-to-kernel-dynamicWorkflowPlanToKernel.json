{
  "id": "workflow.host-to-kernel.dynamicWorkflowPlanToKernel",
  "version": "0.2.78",
  "protocol": {
    "family": "host-to-kernel",
    "direction": "project",
    "source": {
      "type": "DynamicWorkflowPlan",
      "layer": "host",
      "authority": "host-runtime"
    },
    "target": {
      "type": "KernelDynamicWorkflowPlan",
      "layer": "kernel",
      "authority": "kernel"
    },
    "adapter": "workflow/dynamic:dynamicWorkflowPlanToKernel",
    "lossiness": "intentional",
    "validation": {
      "mode": "behavioral-tests",
      "reason": "Workflow ABI tests cover node lowering, snake_case fields, and root composition.",
      "testRefs": [
        {
          "path": "node/tests/workflow-boundary.test.ts",
          "selectors": [
            "workflow host-to-kernel boundary"
          ]
        },
        {
          "path": "node/tests/workflow-definition.test.ts",
          "selectors": [
            "workflowNodeSpecToKernel lowers a node's context to the kernel dependency_context"
          ]
        },
        {
          "path": "node/tests/workflow-optimization.test.ts",
          "selectors": [
            "W-N2 / W-N7: spawn descriptors carry data edges and per-node caps"
          ]
        }
      ]
    }
  },
  "fields": {
    "preserves": {
      "declared": [
        "sequence"
      ],
      "inferred": [
        "sequence"
      ]
    },
    "renames": {
      "runId": "run_id"
    },
    "drops": {
      "declared": [],
      "inferred": []
    },
    "derived": [],
    "forbidden": [],
    "envelope": {
      "source": [],
      "target": []
    },
    "nested": [
      {
        "source": "nodes.[].nodeId",
        "target": "nodes.[].node_id",
        "kind": "project"
      },
      {
        "source": "nodes.[].dependsOn",
        "target": "nodes.[].depends_on",
        "kind": "project"
      },
      {
        "source": "nodes.[].promptFingerprint",
        "target": "nodes.[].prompt_fingerprint",
        "kind": "project"
      },
      {
        "source": "nodes.[].replay",
        "target": "nodes.[].replay",
        "kind": "project"
      }
    ]
  },
  "lazy": {
    "lazySemantics": "none"
  },
  "adapterSignature": {
    "parameters": [
      {
        "name": "plan",
        "type": "DynamicWorkflowPlan"
      }
    ],
    "returnType": "KernelDynamicWorkflowPlan"
  }
}
