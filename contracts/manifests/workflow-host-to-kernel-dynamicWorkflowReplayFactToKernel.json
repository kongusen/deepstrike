{
  "id": "workflow.host-to-kernel.dynamicWorkflowReplayFactToKernel",
  "version": "0.2.74",
  "protocol": {
    "family": "host-to-kernel",
    "direction": "project",
    "source": {
      "type": "DynamicWorkflowReplayFact",
      "layer": "host",
      "authority": "host-runtime"
    },
    "target": {
      "type": "KernelDynamicWorkflowReplayFact",
      "layer": "kernel",
      "authority": "kernel"
    },
    "adapter": "workflow/dynamic:dynamicWorkflowReplayFactToKernel",
    "lossiness": "intentional",
    "validation": {
      "mode": "behavioral-tests",
      "reason": "Workflow ABI and control-flow tests cover node lowering, snake_case fields, and root composition.",
      "testRefs": [
        {
          "path": "node/tests/workflow-boundary.test.ts",
          "selectors": [
            "workflow host-to-kernel boundary"
          ]
        },
        {
          "path": "node/tests/workflow-control-flow.test.ts",
          "selectors": [
            "workflowNodeSpecToKernel: control-flow kinds"
          ]
        },
        {
          "path": "node/tests/workflow-optimization.test.ts",
          "selectors": [
            "W-N2 / W-N7: spawn descriptors carry data edges and per-node caps"
          ]
        }
      ]
    }
  },
  "fields": {
    "preserves": {
      "declared": [
        "sequence",
        "status",
        "replay"
      ],
      "inferred": [
        "sequence",
        "status",
        "replay",
        "termination"
      ]
    },
    "renames": {
      "runId": "run_id",
      "nodeId": "node_id",
      "promptFingerprint": "prompt_fingerprint",
      "resultDigest": "result_digest"
    },
    "drops": {
      "declared": [],
      "inferred": []
    },
    "derived": [],
    "forbidden": [],
    "envelope": {
      "source": [],
      "target": []
    },
    "nested": []
  },
  "lazy": {
    "lazySemantics": "none"
  },
  "adapterSignature": {
    "parameters": [
      {
        "name": "fact",
        "type": "DynamicWorkflowReplayFact"
      }
    ],
    "returnType": "KernelDynamicWorkflowReplayFact"
  }
}
