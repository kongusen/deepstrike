{
  "id": "openai-request.build.OpenAIResponsesAdapter.buildRequestAtBoundary",
  "version": "0.2.73",
  "protocol": {
    "family": "host-provider",
    "direction": "encode",
    "source": {
      "type": "OpenAIResponsesRequestBuildRequest",
      "layer": "host",
      "authority": "host-runtime"
    },
    "target": {
      "type": "OpenAIResponsesRequestPlan",
      "layer": "provider",
      "authority": "provider"
    },
    "adapter": "providers/openai-responses-adapter:OpenAIResponsesAdapter.buildRequestAtBoundary",
    "lossiness": "intentional",
    "validation": {
      "mode": "behavioral-tests",
      "reason": "OpenAI request tests cover dialect preparation, continuation state, and native token-count plans.",
      "testRefs": [
        "node/tests/openai-adapter.test.ts",
        "node/tests/openai-responses-adapter.test.ts"
      ]
    }
  },
  "fields": {
    "preserves": {
      "declared": [],
      "inferred": []
    },
    "renames": {},
    "drops": {
      "declared": [],
      "inferred": []
    },
    "derived": [],
    "forbidden": [],
    "envelope": {
      "source": [
        "input",
        "state"
      ],
      "target": [
        "params"
      ]
    },
    "nested": [
      {
        "source": "input.context",
        "target": "params",
        "kind": "project",
        "note": "canonical messages become Responses input items."
      },
      {
        "source": "input.tools",
        "target": "params",
        "kind": "project",
        "note": "canonical tools and built-ins become Responses tools."
      },
      {
        "source": "input.extensions",
        "target": "params",
        "kind": "project",
        "note": "provider extensions become Responses params."
      },
      {
        "source": "state",
        "target": "params",
        "kind": "state-effect",
        "note": "previous response state becomes continuation params."
      }
    ]
  },
  "lazy": {
    "lazySemantics": "none"
  },
  "adapterSignature": {
    "parameters": [
      {
        "name": "request",
        "type": "OpenAIResponsesRequestBuildRequest"
      }
    ],
    "returnType": "OpenAIResponsesRequestPlan"
  }
}
