{
  "id": "kernel-projection.host-to-kernel.toolSchemaToKernel",
  "version": "0.2.73",
  "protocol": {
    "family": "host-to-kernel",
    "direction": "project",
    "source": {
      "type": "ToolSchema",
      "layer": "host",
      "authority": "host-runtime"
    },
    "target": {
      "type": "KernelToolSchema",
      "layer": "kernel",
      "authority": "kernel"
    },
    "adapter": "runtime/kernel-step:toolSchemaToKernel",
    "lossiness": "intentional",
    "validation": {
      "mode": "behavioral-tests",
      "reason": "Kernel projection tests cover snake-case fields, parsed arguments, and optional data handling.",
      "testRefs": [
        "node/tests/kernel-projection-boundary.test.ts"
      ]
    }
  },
  "fields": {
    "preserves": {
      "declared": [
        "name",
        "description"
      ],
      "inferred": [
        "name",
        "description"
      ]
    },
    "renames": {},
    "drops": {
      "declared": [
        "parameters",
        "providerOptions"
      ],
      "inferred": [
        "providerOptions"
      ]
    },
    "derived": [
      "parameters"
    ],
    "forbidden": [],
    "envelope": {
      "source": [],
      "target": []
    },
    "nested": []
  },
  "lazy": {
    "lazySemantics": "none"
  },
  "adapterSignature": {
    "parameters": [
      {
        "name": "schema",
        "type": "ToolSchema"
      }
    ],
    "returnType": "KernelToolSchema"
  }
}
