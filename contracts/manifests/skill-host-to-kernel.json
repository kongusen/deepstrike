{
  "id": "skill.host-to-kernel",
  "version": "0.2.75",
  "protocol": {
    "family": "host-to-kernel",
    "direction": "project",
    "source": {
      "type": "SkillMetadata",
      "layer": "host",
      "authority": "host-runtime"
    },
    "target": {
      "type": "KernelSkillMetadata",
      "layer": "kernel",
      "authority": "kernel"
    },
    "adapter": "runtime/kernel-step:skillMetadataToKernel",
    "lossiness": "intentional",
    "validation": {
      "mode": "runtime-validator",
      "reason": "Generated validator enforces forbidden, required, unexpected, and target-shape fields at runtime.",
      "testRefs": [
        "node/tests/skill-kernel-projection-validator.test.ts"
      ]
    }
  },
  "fields": {
    "preserves": {
      "declared": [],
      "inferred": [
        "name",
        "description",
        "effort"
      ]
    },
    "renames": {
      "whenToUse": "when_to_use",
      "estimatedTokens": "estimated_tokens",
      "allowedTools": "allowed_tools",
      "capabilityGrants": "capability_grants"
    },
    "drops": {
      "declared": [],
      "inferred": []
    },
    "derived": [],
    "forbidden": [
      "provider_credentials",
      "activation_authority",
      "storage_backend",
      "user_storage_path",
      "source_adapter"
    ],
    "envelope": {
      "source": [],
      "target": []
    },
    "nested": []
  },
  "lazy": {
    "lazyFields": [
      "instructions",
      "resource_contents",
      "scripts",
      "assets"
    ],
    "lazySemantics": "preserve"
  },
  "adapterSignature": {
    "parameters": [
      {
        "name": "skill",
        "type": "SkillMetadata"
      }
    ],
    "returnType": "KernelSkillMetadata"
  }
}
