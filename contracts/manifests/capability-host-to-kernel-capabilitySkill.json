{
  "id": "capability.host-to-kernel.capabilitySkill",
  "version": "0.2.73",
  "protocol": {
    "family": "host-to-kernel",
    "direction": "project",
    "source": {
      "type": "SkillMetadata",
      "layer": "host",
      "authority": "host-runtime"
    },
    "target": {
      "type": "KernelCapabilitySkill",
      "layer": "kernel",
      "authority": "kernel"
    },
    "adapter": "runtime/kernel-step:capabilitySkill",
    "lossiness": "intentional",
    "validation": {
      "mode": "behavioral-tests",
      "reason": "Capability boundary tests cover tool, skill, marker, mount, and unmount projections.",
      "testRefs": [
        "node/tests/capability-boundary.test.ts",
        "node/tests/skill-kernel-projection-validator.test.ts"
      ]
    }
  },
  "fields": {
    "preserves": {
      "declared": [
        "description"
      ],
      "inferred": [
        "description"
      ]
    },
    "renames": {},
    "drops": {
      "declared": [
        "name",
        "whenToUse",
        "effort",
        "estimatedTokens",
        "capabilityGrants",
        "allowedTools"
      ],
      "inferred": [
        "name",
        "whenToUse",
        "effort",
        "estimatedTokens",
        "capabilityGrants",
        "allowedTools"
      ]
    },
    "derived": [
      "id",
      "kind",
      "skill"
    ],
    "forbidden": [],
    "envelope": {
      "source": [],
      "target": []
    },
    "nested": []
  },
  "lazy": {
    "lazySemantics": "none"
  },
  "adapterSignature": {
    "parameters": [
      {
        "name": "skill",
        "type": "SkillMetadata"
      }
    ],
    "returnType": "KernelCapabilitySkill"
  }
}
