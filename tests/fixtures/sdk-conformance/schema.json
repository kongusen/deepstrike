{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepStrike cross-SDK conformance fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "domain", "input", "expected"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "domain": {
      "type": "string",
      "enum": [
        "agent_ir",
        "provider_request_plan",
        "durable_tool_result",
        "prompt_measurement",
        "provider_error",
        "session_event"
      ]
    },
    "input": { "type": "object" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical": { "type": "object" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "path"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "pattern": "^(|/(?:[^~/]|~[01])*)*$" }
          }
        }
      },
      "oneOf": [
        { "required": ["canonical"] },
        { "required": ["error"] }
      ]
    }
  }
}
