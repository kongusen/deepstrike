      "crates/deepstrike-core/src/runtime/kernel/tests.rs::prompt_reservations_cannot_consume_the_entire_context_window",
      "crates/deepstrike-core/src/runtime/kernel/tests.rs::configured_prompt_reservations_are_journaled_and_fail_closed"
    ]
  },
  "target": "§4.5"
}
