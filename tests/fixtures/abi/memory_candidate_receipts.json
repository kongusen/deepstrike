        "candidate_id": "cand-1",
        "receipt_id": "rcpt-1"
      },
      "expected": {
        "status": "succeeded",
        "result": {
          "kind": "memory_persisted",
          "candidate": {
            "binding_id": "fixture-memory",
            "candidate_id": "cand-1",
            "receipt_id": "rcpt-1"
